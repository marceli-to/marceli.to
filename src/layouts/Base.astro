---
import { Font, getImage } from 'astro:assets';
import '../styles/global.css';
import { contact, kimiyu, site } from '../data/site';
import { alternates, getLang, useStrings } from '../data/i18n';
import marcel from '../assets/marcel.jpg';

interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD nodes for this page, merged into the site graph */
  graph?: object[];
  noindex?: boolean;
}

const lang = getLang(Astro.currentLocale);
const t = useStrings(lang);
const { title = t.title, description = t.description, graph = [], noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const urls = alternates(Astro.url.pathname);
const ogImage = new URL('/og.png', Astro.site).href;
const portrait = new URL((await getImage({ src: marcel, width: 600, format: 'jpg' })).src, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: `${site.url}/`,
      name: site.name,
      inLanguage: ['de-CH', 'en'],
      publisher: { '@id': `${site.url}/#person` },
    },
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: contact.name,
      url: `${site.url}/`,
      image: portrait,
      jobTitle: t.person.jobTitle,
      description: t.person.description,
      email: `mailto:${contact.email}`,
      telephone: `+41 ${contact.phone.replace(/^0/, '')}`,
      address: {
        '@type': 'PostalAddress',
        streetAddress: contact.street,
        postalCode: contact.postalCode,
        addressLocality: contact.city,
        addressCountry: contact.country,
      },
      knowsAbout: [...t.person.knowsAbout, 'Laravel', 'Statamic', 'Vue.js', 'Tailwind CSS', 'Astro', 'Claude', 'Model Context Protocol (MCP)'],
    },
    {
      '@type': 'Organization',
      '@id': `${kimiyu.url}/#organization`,
      name: kimiyu.name,
      url: `${kimiyu.url}/`,
      founder: { '@id': `${site.url}/#person` },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${canonical}#page`,
      url: canonical,
      name: title,
      description,
      inLanguage: t.lang,
      isPartOf: { '@id': `${site.url}/#website` },
      mainEntity: { '@id': `${site.url}/#person` },
    },
    ...graph,
  ],
};
---

<!doctype html>
<html lang={t.lang} class="scroll-smooth bg-bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noindex && urls && (
      <>
        <link rel="alternate" hreflang="de-CH" href={new URL(urls.de, Astro.site).href} />
        <link rel="alternate" hreflang="en" href={new URL(urls.en, Astro.site).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(urls.de, Astro.site).href} />
      </>
    )}
    <meta name="author" content={contact.name} />
    <meta name="theme-color" content="#f5eedf" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/markdown" href={`${t.home}llms.txt`} title={t.llmsTitle} />

    <Font cssVariable="--font-figtree" preload />
    <Font cssVariable="--font-dm-mono" />

    <script is:inline>if (localStorage.getItem('lights') === 'night') document.documentElement.classList.add('night')</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-bg text-ink antialiased flex flex-col min-h-screen font-sans text-md lg:text-lg leading-[1.55] selection:bg-lamp selection:text-navy">
    <slot />
    <script>
      import '../scripts/app';
      import '../scripts/webmcp';
    </script>
  </body>
</html>
