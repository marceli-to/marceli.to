---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
---

<Base title="Seite nicht gefunden – Marcel Stadelmann" noindex>
  <Header />
  <main class="flex-1 w-full max-w-[1200px] mx-auto px-20 md:px-32 py-120">
    <p class="font-mono text-xs text-muted">404</p>
    <h1 class="mt-12 text-4xl md:text-5xl font-bold tracking-[-0.03em] leading-[1.08] text-balance">
      Diese Seite gibt es nicht. <a href="/" class="underline [text-decoration-skip-ink:none] decoration-lamp decoration-[0.1em] underline-offset-[0.14em]">Zur Startseite</a>.
    </h1>
    <p lang="en" class="mt-24 text-muted">
      This page doesn’t exist. <a href="/en/" class="text-ink underline [text-decoration-skip-ink:none] decoration-lamp decoration-2 underline-offset-4">Go to the homepage</a>.
    </p>
  </main>
</Base>
