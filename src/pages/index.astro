---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import { contact, site } from '../data/site';
import { displayName, getAgencies, getProjects, shortName } from '../lib/projects';

const projects = await getProjects();

// Machine-readable project list for agents (WebMCP tools, see src/scripts/webmcp.ts)
const siteData = {
  contact,
  projects: projects.map((project) => ({
    name: displayName(project),
    client: project.data.client,
    studio: project.data.agency ? shortName(project.data.agency) : null,
    year: project.data.year,
    url: project.data.offline ? null : project.data.link,
    offline: project.data.offline,
    description: project.data.description,
  })),
};

const projectList = {
  '@type': 'ItemList',
  '@id': `${site.url}/#projects`,
  name: 'Arbeiten',
  numberOfItems: projects.length,
  itemListElement: projects.map((project, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'CreativeWork',
      name: displayName(project),
      description: project.data.description,
      dateCreated: String(project.data.year),
      ...(project.data.offline ? {} : { url: project.data.link }),
      creator: { '@id': `${site.url}/#person` },
      ...(project.data.agency ? { contributor: { '@type': 'Organization', name: shortName(project.data.agency) } } : {}),
    },
  })),
};
---

<Base graph={[projectList]}>
  <Header />
  <main class="flex-1 w-full">
    <Hero />
    <Projects projects={projects} />
    <About agencies={getAgencies(projects)} />
  </main>
  <Footer />
  <script type="application/json" id="site-data" set:html={JSON.stringify(siteData)} />
</Base>
