---
import { getLang, useStrings } from '../data/i18n';

const t = useStrings(getLang(Astro.currentLocale));
---

<button
  type="button"
  data-lights-toggle
  aria-pressed="false"
  aria-label={t.lights.label}
  title={t.lights.title}
  class="group relative -mx-8 size-40 grid place-items-center cursor-pointer">
  <svg viewBox="0 0 24 24" class="size-24 overflow-visible" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="17" r="6" class="fill-lamp opacity-0 night:opacity-40 blur-[3px] transition-opacity duration-500" stroke="none" />
    <path d="M12 1v5" class="origin-top group-hover:animate-[wobble_0.6s_ease-in-out]" />
    <path d="M5 13a7 7 0 0 1 14 0z" class="fill-bg night:fill-lamp transition-colors duration-500" />
    <path d="M10 16a2 2 0 0 0 4 0" />
  </svg>
</button>
