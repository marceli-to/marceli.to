---
import Portrait from './Portrait.astro';
import { getLang, useStrings } from '../data/i18n';
import { kimiyu } from '../data/site';

interface Props {
  agencies: string[];
}

const { agencies } = Astro.props;
const t = useStrings(getLang(Astro.currentLocale));
// A \n in the headline breaks the line from md
const [before, after] = [t.about.headline.before, t.about.headline.after].map((text) => text.split('\n'));
---

<section id={t.ids.about} class="scroll-mt-64 md:scroll-mt-80 w-full border-t border-line mt-96 md:mt-160">
  <div class="max-w-[1200px] mx-auto px-20 md:px-32 pt-64 md:pt-96">
    <h2 class="text-3xl md:text-5xl font-semibold tracking-[-0.02em] leading-[1.2] md:leading-[1.12] max-w-[22ch] text-balance">
      {before.map((part, index) => <>{index > 0 && <br class="hidden md:inline" />}{part}</>)}<span class="whitespace-nowrap underline [text-decoration-skip-ink:none] decoration-lamp decoration-[0.1em] underline-offset-[0.14em]">{t.about.headline.underlined}</span>{after.map((part, index) => <>{index > 0 && <br class="hidden md:inline" />}{part}</>)}
    </h2>

    <div class="mt-48 md:mt-72 grid md:grid-cols-12 gap-y-56 gap-x-32 items-start">
      <div class="md:col-span-6">
        <div class="space-y-16 text-muted text-pretty">
          {t.about.text.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <dl class="mt-40 grid grid-cols-[auto_1fr] gap-x-32 gap-y-12 text-md">
          <dt class="font-mono text-xs text-muted pt-4">{t.about.role}</dt>
          <dd>{t.about.roleText}</dd>
          <dt class="font-mono text-xs text-muted pt-4">{t.about.tools}</dt>
          <dd>Laravel, Statamic, Vue.js, Tailwind CSS, Claude, MCP</dd>
          <dt class="font-mono text-xs text-muted pt-4">{t.about.also}</dt>
          <dd>{t.about.founder.before}<a href={kimiyu.url} class="underline [text-decoration-skip-ink:none] decoration-lamp decoration-2 underline-offset-[5px] hover:text-lamp transition-colors">{kimiyu.name}</a>{t.about.founder.after}</dd>
        </dl>
      </div>
      <div class="md:col-span-5 md:col-start-8 lg:col-span-4 lg:col-start-9 relative max-w-[360px] md:max-w-none w-full mx-auto">
        <figure class="group/portrait bg-paper p-12 pb-0 rounded-[20px] shadow-[0_24px_48px_-24px_rgb(31_43_71/0.35)] ring-1 ring-line rotate-2 hover:rotate-0 transition-transform duration-500">
          <Portrait class="rounded-[12px]" />
          <figcaption class="font-mono text-xs text-muted py-12 px-4">Marcel Stadelmann</figcaption>
        </figure>
        <span class="absolute -left-8 md:-left-32 top-24 -rotate-6 rounded-full bg-lamp text-navy font-mono text-xs px-12 py-6 shadow-sm">{t.about.sticker}</span>
      </div>
    </div>

    <div class="mt-72 md:mt-120">
      <p class="font-mono text-xs text-muted">{t.about.workedWith}</p>
      <p class="mt-16 text-xl md:text-3xl font-medium tracking-[-0.01em] leading-[1.45] text-balance">
        {agencies.map((name, index) => (
          <>
            <span class="whitespace-nowrap">{name}{index < agencies.length - 1 && <>&nbsp;<span class="text-muted font-normal" aria-hidden="true">·</span></>}</span>{' '}
          </>
        ))}
        <span class="text-muted">{t.about.andMore}</span>
      </p>
    </div>
  </div>
</section>
