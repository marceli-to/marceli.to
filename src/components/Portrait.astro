---
// The illustrated portrait. At night the scene darkens and its lamps and windows light up.
// Keep the container square so the glow positions line up with the drawing.
import { Image } from 'astro:assets';
import marcel from '../assets/marcel.jpg';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['relative aspect-square overflow-hidden', className]}>
  <Image
    src={marcel}
    alt="Illustration: Marcel mit Oerlikon-Mütze vor einem Café"
    widths={[400, 600, 900]}
    sizes="(min-width: 1024px) 360px, (min-width: 768px) 40vw, 360px"
    class="block size-full object-cover"
  />
  <div class="portrait-night absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 bg-[#4a5a94] mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_28%_62%,rgb(255_190_90/0.35),transparent_45%)] mix-blend-screen"></div>
    <div class="portrait-window left-[81%] top-[5%] w-[11%] h-[12%] opacity-50"></div>
    <div class="portrait-window left-[75%] top-[47%] w-[10%] h-[16%] opacity-50"></div>
    <div class="portrait-glow left-[3.5%] top-[45.5%] size-[7%]"></div>
    <div class="portrait-glow left-[23%] top-[60%] size-[6%]"></div>
    <div class="portrait-glow left-[30%] top-[59%] size-[6%]"></div>
    <div class="portrait-glow left-[35%] top-[64%] size-[6%]"></div>
  </div>
</div>
