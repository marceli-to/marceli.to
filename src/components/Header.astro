---
import Logo from './icons/Logo.astro';
import Menu from './Menu.astro';
import Burger from './Burger.astro';
import { getLang, useStrings } from '../data/i18n';

const t = useStrings(getLang(Astro.currentLocale));
---

<header data-header class="group/header sticky top-0 z-40 w-full text-ink">
  <Menu />
  <div class="relative max-w-[1200px] mx-auto px-20 md:px-32 h-64 md:h-80 flex items-center justify-between gap-x-24">
    <!-- Only the logo fades out when scrolling down, the burger stays -->
    <a href={t.home} class="text-ink hover:text-accent transition-[color,opacity,translate] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-data-hidden/header:opacity-0 group-data-hidden/header:-translate-y-8 group-data-hidden/header:pointer-events-none" title={t.nav.home}>
      <Logo class="block w-[132px] md:w-[168px] h-auto" />
    </a>
    <Burger controls="menu" />
  </div>
</header>
