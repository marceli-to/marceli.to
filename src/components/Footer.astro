---
import { contact } from '../data/site';
import Heart from './icons/Heart.astro';
import LangSwitch from './LangSwitch.astro';
import { getLang, pages, useStrings } from '../data/i18n';

const lang = getLang(Astro.currentLocale);
const t = useStrings(lang);

const year = new Date().getFullYear();
const link = 'underline [text-decoration-skip-ink:none] decoration-transparent decoration-2 underline-offset-[5px] transition-[color,text-decoration-color]';
---

<footer id={t.ids.contact} class="w-full border-t border-line mt-96 md:mt-160">
  <div class="max-w-[1200px] mx-auto px-20 md:px-32 pt-64 md:pt-96 pb-40">
    <h2 data-reveal class="text-4xl md:text-6xl font-bold tracking-[-0.015em] leading-[1.2] md:leading-[1.04] text-balance max-w-[16ch]">
      {t.footer.question} <a href={`mailto:${contact.email}`} class="whitespace-nowrap underline [text-decoration-skip-ink:none] decoration-leaf night:decoration-[#7fae6a] decoration-[0.1em] underline-offset-[0.14em] hover:text-leaf night:hover:text-[#7fae6a] transition-colors">{t.footer.cta}</a>.
    </h2>
    <div data-reveal class="mt-80 md:mt-120 pt-32 border-t border-line flex flex-col sm:flex-row sm:items-start justify-between gap-32 text-sm leading-[1.6]">
      <address class="not-italic text-muted flex flex-col items-start gap-y-2">
        <span>{contact.name}</span>
        <span>{contact.street}</span>
        <span>{contact.postalCode} {contact.city}</span>
        <a href={`tel:+41${contact.phone.replace(/\s/g, '').replace(/^0/, '')}`} class:list={['hover:text-ink hover:decoration-lamp', link]}>{contact.phone}</a>
        <a href={`mailto:${contact.email}`} class:list={['hover:text-ink hover:decoration-lamp', link]}>{contact.email}</a>
      </address>
      <nav aria-label={t.nav.footerLabel} class="flex flex-col items-start sm:items-end gap-y-10 font-medium">
        <a href={`${t.home}#${t.ids.projects}`} class:list={['hover:decoration-brick', link]}>{t.nav.projects}</a>
        <a href={`${t.home}#${t.ids.about}`} class:list={['hover:decoration-lamp', link]}>{t.nav.about}</a>
        <a href={`${t.home}#${t.ids.contact}`} class:list={['hover:decoration-leaf night:hover:decoration-[#7fae6a]', link]}>{t.nav.contact}</a>
        <LangSwitch />
      </nav>
    </div>
    <p class="mt-56 md:mt-72 text-center font-mono text-xs text-muted">© {year} – {t.footer.builtWith} <Heart label={t.footer.love} class="inline-block size-14 align-[-2px] fill-accent" /> {t.footer.in}</p>
    <nav aria-label={t.legal.label} class="mt-12 text-center font-mono text-xs text-muted">
      <a href={pages.imprint[lang]} class:list={['hover:text-lamp hover:decoration-lamp', link]}>{t.legal.imprint}</a>{' · '}<a href={pages.privacy[lang]} class:list={['hover:text-lamp hover:decoration-lamp', link]}>{t.legal.privacy}</a>
    </nav>
  </div>
</footer>
