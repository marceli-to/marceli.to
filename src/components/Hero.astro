---
import { Image } from 'astro:assets';
import marcel from '../assets/marcel.jpg';
import { getLang, useStrings } from '../data/i18n';

const t = useStrings(getLang(Astro.currentLocale));
---

<section class="relative max-w-[1200px] mx-auto px-20 md:px-32 min-h-[calc(100svh-64px)] md:min-h-[calc(100svh-80px)] flex flex-col justify-center pt-40 pb-120">
  <!-- Intro (see global.css): the sentence settles, the portrait pops, then the colours and the underline arrive -->
  <h1 class="hero-fade text-4xl md:text-5xl lg:text-6xl font-bold tracking-[-0.015em] leading-[1.22] md:leading-[1.08] max-w-[18ch] md:max-w-[22ch] text-balance">
    {t.hero.hi} <span class="whitespace-nowrap"><span class="hero-pop inline-block align-[-0.08em] md:align-[-0.12em] mr-12"><a href={`#${t.ids.about}`} title={t.nav.about} class="block size-[0.86em] md:size-[1em] rounded-full overflow-hidden ring-4 ring-lamp hover:animate-[wobble_0.6s_ease-in-out]"><Image src={marcel} alt="Marcel" width={192} height={192} loading="eager" fetchpriority="high" class="size-full object-cover scale-[1.25] origin-[56%_42%]" /></a></span>Marcel.</span><br />
    {t.hero.build} <span class="hero-tint text-accent [--d:900ms]">{t.hero.websites}</span> {t.hero.and} <span class="hero-tint text-leaf night:text-lamp [--d:1250ms]">{t.hero.workflows}</span>{t.hero.that} <span class="hero-draw">{t.hero.keep}</span>{t.hero.pause} <span class="md:whitespace-nowrap">{t.hero.promise}.</span>
  </h1>
  <a
    href={`#${t.ids.projects}`}
    aria-label={t.hero.toProjects}
    data-scroll-hint
    class="hero-chrome group absolute bottom-32 left-1/2 -translate-x-1/2 p-12 text-muted hover:text-ink transition-[color,opacity] duration-300 data-hidden:opacity-0 data-hidden:pointer-events-none">
    <svg viewBox="0 0 24 24" class="size-24 group-hover:translate-y-4 transition-transform" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 4v16M5 13l7 7 7-7" />
    </svg>
  </a>
</section>
